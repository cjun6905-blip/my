  "memory_bytes": 536870912,
  "pids_limit": null,
  "readonly_root": false,
  "healthcheck": {
    "Test": [
      "CMD",
      "python3",
      "-c",
      "import os; os.kill(1, 0)"
    ],
    "Interval": 30000000000,
    "Timeout": 5000000000,
    "StartPeriod": 45000000000,
    "Retries": 3
  }
}
