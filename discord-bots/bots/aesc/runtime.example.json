{
  "profile": "aesc",
  "base_image": "speech-unify-aesc:20261103t101012z",
  "working_dir": "/app",
  "entrypoint": null,
  "command": [
    "python3",
    "-u",
    "-m",
    "src.main"
  ],
  "user": "0",
  "environment": {
    "IMAGEGEN_ENV_FILE": "/run/secrets/imagegen.env",
    "SPEECH_ENV_FILE": "/run/secrets/speech.env"
  },
  "env_keys": [
    "PUBLIC_HOST",
    "DEPLOY_ROOT",
    "GPT_IMAGE_API_KEY",
    "DEVELOPER_USER_IDS",
    "GUIDANCE_HOST",
    "GPT_IMAGE_MODEL",
    "ADMIN_ROLE_IDS",
    "IMAGEGEN_ENV_FILE",
    "GUILD_ID",
    "GPT_IMAGE_BASE_URL",
    "DISABLED_TOOLS",
    "OPENAI_COMPATIBLE_MODELS",
    "YGO_PUBLIC_ORIGIN",
    "BLACKJACK_HOST",
    "APP_BACKUP_DIR",
    "WEB_SCRAPE_TIMEOUT",
    "YGO_SERVICE_URL",
    "SEARXNG_URL",
    "ADMIN_DISCORD_CLIENT_ID",
    "WEB_SEARCH_MAX_RESULTS",
    "ADMIN_SESSION_SECRET",
    "DIARY_HOST",
    "POSTGRES_USER",
    "DB_HOST",
    "ADMIN_PUBLIC_BASE_URL",
    "DISCORD_TOKEN",
    "YGO_INTERNAL_SECRET",
    "OPENAI_COMPATIBLE_URL",
    "GUILD_ALLOWLIST",
    "INSTANCE_NAME",
    "BLUFF_INTERNAL_SECRET",
    "GUIDANCE_CHANNEL_ID",
    "RUNNING_IN_DOCKER",
    "CHAT_ENABLED",
    "DISCORD_CLIENT_SECRET",
    "WEB_SCRAPE_MAX_LENGTH",
    "VITE_DISCORD_CLIENT_ID",
    "WEB_SEARCH_TIMEOUT",
    "GOOGLE_API_KEYS_LIST",
    "DEPLOY_ENV_FILE",
    "POSTGRES_DB",
    "POSTGRES_PASSWORD",
    "VECTOR_MODE",
    "GUIDANCE_TRIGGER_ROLE_ID",
    "SPEECH_ENV_FILE",
    "COMPOSE_PROJECT_NAME",
    "OPENAI_COMPATIBLE_DEFAULT_MODEL",
    "OPENAI_COMPATIBLE_API_KEY",
    "LOG_AI_FULL_CONTEXT",
    "PATH",
    "LANG",
    "GPG_KEY",
    "PYTHON_VERSION",
    "PYTHON_PIP_VERSION",
    "PYTHON_SETUPTOOLS_VERSION",
    "PYTHON_GET_PIP_URL",
    "PYTHON_GET_PIP_SHA256"
