{
  "profile": "morgan",
  "base_image": "speech-unify-morgan:20261103t101345z",
  "working_dir": "/app",
  "entrypoint": null,
  "command": [
    "python3",
    "-u",
    "-m",
    "src.main"
  ],
  "user": "0",
  "environment": {
    "SPEECH_ENV_FILE": "/run/secrets/speech.env",
    "IMAGEGEN_ENV_FILE": "/run/secrets/imagegen.env"
  },
  "env_keys": [
    "POSTGRES_PASSWORD",
    "VITE_DISCORD_CLIENT_ID",
    "ADMIN_ROLE_IDS",
    "OPENAI_COMPATIBLE_API_KEY",
    "DISCORD_TOKEN",
    "POSTGRES_DB",
    "LOG_AI_FULL_CONTEXT",
    "ADMIN_DISCORD_CLIENT_ID",
    "WEB_SCRAPE_MAX_LENGTH",
    "RUNNING_IN_DOCKER",
    "ADMIN_PUBLIC_BASE_URL",
    "DB_HOST",
    "WEB_SCRAPE_TIMEOUT",
    "WEB_SEARCH_TIMEOUT",
    "WEB_SEARCH_MAX_RESULTS",
    "VECTOR_MODE",
    "CHAT_ENABLED",
    "GUILD_ALLOWLIST",
    "DISCORD_CLIENT_SECRET",
    "DB_PORT",
    "ADMIN_SESSION_SECRET",
    "DISABLED_TOOLS",
    "DISCORD_CLIENT_ID",
    "INSTANCE_NAME",
    "SPEECH_ENV_FILE",
    "BOT_APP_ID",
    "COMPOSE_PROJECT_NAME",
    "DEVELOPER_USER_IDS",
    "GUILD_ID",
    "OPENAI_COMPATIBLE_URL",
    "SEARXNG_URL",
    "POSTGRES_USER",
    "IMAGEGEN_ENV_FILE",
    "PATH",
    "LANG",
    "GPG_KEY",
    "PYTHON_VERSION",
    "PYTHON_PIP_VERSION",
    "PYTHON_SETUPTOOLS_VERSION",
    "PYTHON_GET_PIP_URL",
    "PYTHON_GET_PIP_SHA256"
  ],
  "memory_bytes": 536870912,
  "pids_limit": 160,
  "readonly_root": false,
  "healthcheck": null
}
